<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
prefHeight="500.0"
prefWidth="700.0"
xmlns="http://javafx.com/javafx/23"
xmlns:fx="http://javafx.com/fxml"
fx:controller="com.example.Controller">

    <children>

        <Label layoutX="30" layoutY="30" text="Name"/>

        <TextField fx:id="txtName"
                   layoutX="120"
                   layoutY="25"
                   prefWidth="200"/>

        <Label layoutX="30"
               layoutY="80"
               text="Course"/>

        <TextField fx:id="txtCourse"
                   layoutX="120"
                   layoutY="75"
                   prefWidth="200"/>

        <Label layoutX="30"
               layoutY="130"
               text="Year Level"/>

        <ChoiceBox fx:id="cbYear"
                   layoutX="120"
                   layoutY="125"
                   prefWidth="200"/>

        <Button layoutX="30"
                layoutY="190"
                text="Add"
                onAction="#addStudent"/>

        <Button layoutX="110"
                layoutY="190"
                text="Update"
                onAction="#updateStudent"/>

        <Button layoutX="210"
                layoutY="190"
                text="Delete"
                onAction="#deleteStudent"/>

        <Button layoutX="310"
                layoutY="190"
                text="Clear"
                onAction="#clearFields"/>

        <TableView fx:id="table"
                   layoutX="30"
                   layoutY="250"
                   prefHeight="220"
                   prefWidth="620">

            <columns>

                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="80"/>

                <TableColumn fx:id="colName"
                             text="Name"
                             prefWidth="180"/>

                <TableColumn fx:id="colCourse"
                             text="Course"
                             prefWidth="180"/>

                <TableColumn fx:id="colYear"
                             text="Year Level"
                             prefWidth="180"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>